{
  "schema": "wf-runner-execution-backend/v1",
  "kind": "wsl2",
  "wslExecutable": "C:\\WINDOWS\\System32\\wsl.exe",
  "distro": "Ubuntu2204",
  "interpreter": "/usr/bin/python3",
  "pathMap": [
    {
      "windows": "E:/",
      "linux": "/mnt/e/"
    },
    {
      "windows": "C:/",
      "linux": "/mnt/c/"
    }
  ],
  "sharedReadOnlyBinds": [
    {
      "windows": "E:\\ai\\tool",
      "name": "tool"
    },
    {
      "windows": "E:\\ai\\agent",
      "name": "agent"
    },
    {
      "windows": "E:\\ai\\software",
      "name": "software"
    }
  ],
  "verifyTimeoutSeconds": 300
}
