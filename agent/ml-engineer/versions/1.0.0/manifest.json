{
  "schema": "ai-agent/v2",
  "id": "ml-engineer",
  "version": "1.0.0",
  "displayName": "ml-engineer",
  "role": "先定义预测时刻、标签与可用特征，按时间或实体隔离训练/验证/测试。预处理仅在训练集拟合，和基线比较；指标按任务损失与类别代价选。部署接口包含版本、输入漂移与回退，不用测试集反复调参。",
  "prompt": "prompt.md",
  "toolLock": "tool-lock.json",
  "workflows": [
    "ml-engineer-pipeline"
  ],
  "runnerWorkflow": "ml-engineer-pipeline",
  "policies": [
    "project-scoped",
    "no-credentials",
    "no-destructive-default"
  ],
  "permissions": {
    "filesystem": "project-scoped",
    "network": "deny",
    "process": "allowlisted-only"
  },
  "packs": {},
  "windowProfile": 128000,
  "x-contextBudget": {
    "schema": "ai-context-budget-policy/v1",
    "coreMax": 2500,
    "auxiliaryMax": 4000,
    "stageMax": 1500,
    "normalMax": 8000,
    "absoluteMax": 12000,
    "reworkAllowance": 2,
    "deepReadBatchMax": 4000,
    "handoffMax": 2000,
    "estimator": "cjk-1.1-other-3.6-v1",
    "coreSkill": "domain-core-ml-engineer",
    "windowSharePercent": 25
  },
  "x-taskCategories": [
    "特征",
    "训练/验证切分",
    "传统 ML/深度学习",
    "评估",
    "误差分析",
    "部署接口"
  ],
  "x-domainBoundary": "管可训练模型；LLM/RAG/工具调用交 llm",
  "x-runtimeRequirements": {
    "ownership": "platform/runtime",
    "profile": "portable-resource-python",
    "packages": {
      "numpy": "1.26.4",
      "scikit-learn": "1.7.2"
    },
    "when": "执行相应库工具时必需；规格/计划任务可仅生成文本，不能据此声称工具已执行"
  },
  "integrity": {
    "sha256Manifest": "SHA256SUMS"
  }
}
