{
  "schema": "ai-agent/v2",
  "id": "research-analyst",
  "version": "1.1.0",
  "displayName": "research-analyst",
  "role": "先把研究问题拆为可证实主张，定义检索范围和时效。单篇论文精读时，按论文结构提取研究问题、方法模块、关键公式、实验—结论证据链与结论边界；区分作者陈述、外部事实、自己的推断与研究假设。来源按一手性、方法、偏差和可回读程度评估；保留矛盾证据与无法验证项。论文写作主责仍由 paper-author 承担。",
  "prompt": "prompt.md",
  "toolLock": "tool-lock.json",
  "workflows": [
    "research-analyst-pipeline"
  ],
  "runnerWorkflow": "research-analyst-pipeline",
  "policies": [
    "project-scoped",
    "no-credentials",
    "no-destructive-default"
  ],
  "permissions": {
    "filesystem": "project-scoped",
    "network": "deny",
    "process": "allowlisted-only"
  },
  "packs": {},
  "windowProfile": 128000,
  "x-contextBudget": {
    "schema": "ai-context-budget-policy/v1",
    "coreMax": 2500,
    "auxiliaryMax": 4000,
    "stageMax": 1500,
    "normalMax": 8000,
    "absoluteMax": 12000,
    "reworkAllowance": 2,
    "deepReadBatchMax": 4000,
    "handoffMax": 2000,
    "estimator": "cjk-1.1-other-3.6-v1",
    "coreSkill": "domain-core-research-analyst",
    "windowSharePercent": 25
  },
  "x-taskCategories": [
    "检索策略",
    "多源调查",
    "来源核验",
    "比较",
    "证据综述",
    "研究简报",
    "论文精读/讲解",
    "论文深度分析"
  ],
  "x-domainBoundary": "交证据与论文解读；论文写作主责由 paper-author 承担；全文获取受平台网络能力约束",
  "x-runtimeRequirements": {
    "ownership": "platform/runtime",
    "profile": "portable-resource-python",
    "packages": {
      "PyMuPDF": "1.26.4"
    },
    "when": "仅执行论文 PDF 解析/图表裁剪脚本时；无该环境时脚本路径 fail-closed，文本/规划任务可照常，但不得声称已解析"
  },
  "integrity": {
    "sha256Manifest": "SHA256SUMS"
  }
}