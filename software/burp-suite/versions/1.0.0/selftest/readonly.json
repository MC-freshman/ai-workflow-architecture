{
  "schema": "ai-software-selftest/v1",
  "mode": "readonly",
  "checks": [
    {
      "id": "files-present",
      "kind": "file-integrity",
      "files": [
        "BurpSuite\\burpsuite_pro_org.jar",
        "BurpSuite\\burpsuitloader.jar",
        "BurpSuite\\extensions\\burp-mcp-all-2024.5.1-compat.jar",
        "jre\\bin\\java.exe"
      ],
      "notes": "校验 verify.files 中声明的 SHA256；不启动 Burp"
    },
    {
      "id": "mcp-endpoint",
      "capability": "mcpListTools",
      "kind": "http-probe",
      "transport": "mcp-http",
      "endpoint": "http://127.0.0.1:9876",
      "mcpMethod": "tools/list",
      "timeout": 5,
      "onUnreachable": "SKIP",
      "onReachable": {
        "assertResultToolsArray": true,
        "freezeSnapshot": "首次连通时应将 tools/list 结果回填 capabilities.snapshot.json，并把 proxyHistory/scannerScan 的 frozenToolName 补齐后发布新版本"
      },
      "notes": "Burp 是 GUI 单例软件，未启动/未启用 MCP 扩展时端点不可达属正常，自检记 SKIP（软件声明为 available-but-not-running），不计 FAIL"
    }
  ]
}