{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "MCP tools/call 响应（JSON-RPC result）",
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["text", "image", "resource"] },
          "text": { "type": "string" }
        }
      }
    },
    "isError": { "type": "boolean", "default": false }
  }
}