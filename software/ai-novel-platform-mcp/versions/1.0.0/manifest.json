      "nativeName": "novel.project.info",
      "inputSchemaRef": "schemas/empty.input.json",
      "outputSchemaRef": "schemas/result.output.json",
      "sideEffects": "none",
      "permissionRequests": {
        "filesystem": "read",
        "network": "loopback",
        "process": "children",
        "credentials": "none"
      },
      "consent": "auto",
      "idempotent": true,
      "safeForSelftest": true,
      "invocation": {
        "transport": "mcp-stdio",
        "endpoint": "src/server.mjs",
        "mcpMethod": "tools/call",
        "toolNameParam": "params.name",
        "argumentsParam": "params.arguments",
        "frozenToolName": "novel_project_info",
        "timeout": 30,
        "notes": "Fixed tool mapping; no shell, no argv passthrough, no writes."
      }
    },
