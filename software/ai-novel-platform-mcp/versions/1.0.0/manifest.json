{
  "schema": "ai-software/v1",
  "id": "ai-novel-platform-mcp",
  "version": "1.0.0",
  "displayName": "AI Novel Platform MCP (read-only project bridge)",
  "upstreamVersion": "0.3.9",
  "kind": "mcp-stdio",
  "transport": {
    "protocol": "mcp-stdio",
    "command": "node",
    "args": [
      "src/server.mjs"
    ],
    "cwd": ".",
    "protocolVersion": "2025-06-18",
    "capabilityAttestation": "server-tools-list",
    "runtime": "node>=20",
    "notes": "Zero-dependency stdio JSON-RPC. Roots are supplied by environment variables; no absolute path is hardcoded."
