{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Copy between host and guest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "vmPath": {
      "type": "string",
      "description": "Absolute path to a .vmx file inside VMWARE_VMX_ROOTS"
    },
    "hostPath": {
      "type": "string",
      "description": "Host path inside VMWARE_WORKSPACE_ROOT"
    },
    "guestPath": {
      "type": "string",
      "description": "Path inside the guest"
    },
    "confirm": {
      "type": "boolean",
      "description": "Must be true; the server refuses the call before spawning vmrun when it is missing"
    }
  },
  "required": [
    "vmPath",
    "hostPath",
    "guestPath",
    "confirm"
  ]
}
