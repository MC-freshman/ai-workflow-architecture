{
  "schema": "wf-runner-execution-backend/v1",
  "kind": "wsl2",
  "wslExecutable": "C:/WINDOWS/system32/wsl.exe",
  "distro": "Ubuntu2204",
  "interpreter": "/usr/bin/python3",
  "pathMap": [
    {
      "windows": "E:/",
      "linux": "/mnt/e/"
    }
  ],
  "sharedReadOnlyBinds": [
    {
      "windows": "E:/ai/tool",
      "name": "tool"
    },
    {
      "windows": "E:/ai/agent",
      "name": "agent"
    },
    {
      "windows": "E:/ai/software",
      "name": "software"
    }
  ],
  "verifyTimeoutSeconds": 120,
  "declaredBy": "codex 3.0 platform adoption; all shared roots are mounted read-only and independently verified before production use."
}
