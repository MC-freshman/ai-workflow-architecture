{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ai-manager-module/v1",
  "title": "Architecture Manager module registry (derived view, machine-generated)",
  "type": "object",
  "required": ["schema", "generatedAt", "generatedFrom", "summary", "modules", "views"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ai-manager-module/v1" },
    "generatedAt": { "type": "string" },
    "generatedFrom": {
      "type": "object",
      "required": ["operations", "domains", "panels", "views"],
      "additionalProperties": false,
      "properties": {
        "operations": { "type": "string" },
        "domains": { "type": "string" },
        "panels": { "type": "string" },
        "views": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["moduleCount", "domainCount", "panelCount", "viewCount", "channelCount"],
      "additionalProperties": true,
      "properties": {
        "moduleCount": { "type": "integer", "minimum": 1 },
        "domainCount": { "type": "integer", "minimum": 1 },
        "panelCount": { "type": "integer", "minimum": 1 },
        "viewCount": { "type": "integer", "minimum": 1 },
        "channelCount": { "type": "integer", "minimum": 1 }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "entry", "replaceable", "replacementOptions", "impactScope", "matrixRef", "enabled", "replacement"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "enum": ["domain", "panel", "view", "runtime", "gate", "entry", "mechanism", "external"] },
          "entry": { "type": "string", "minLength": 1 },
          "files": { "type": "array", "items": { "type": "string" } },
          "exports": { "type": "array", "items": { "type": "string" } },
          "channels": { "type": "array", "items": { "type": "string" } },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "replaceable": { "type": "boolean" },
          "replacementContract": { "type": ["string", "null"] },
          "replacementOptions": {
            "type": "object",
            "required": ["selfWritten", "softwareIntegration"],
            "additionalProperties": false,
            "properties": {
              "selfWritten": { "type": "string" },
              "softwareIntegration": { "type": "string" }
            }
          },
          "impactScope": { "type": "string" },
          "healthCheck": { "type": ["string", "null"] },
          "matrixRef": { "type": "string", "pattern": "^M[0-9]{2}$" },
          "enabled": { "type": "boolean" },
          "replacement": { "type": ["string", "null"] }
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "group", "description", "panels", "order"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "group": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "panels": { "type": "array", "items": { "type": "string" } },
          "order": { "type": "integer", "minimum": 0 },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "panels"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "panels": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}