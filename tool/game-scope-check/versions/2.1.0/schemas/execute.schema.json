{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-scope-check · EXECUTE",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary",
    "unavailableChecks",
    "features",
    "allocation",
    "capacity",
    "cuts",
    "freeze"
  ],
  "properties": {
    "features": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "estimateHours",
          "impact",
          "feasibility",
          "risk",
          "score",
          "moscow"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "estimateHours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "impact": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "feasibility": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "risk": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "moscow": {
            "enum": [
              "must",
              "should",
              "could",
              "wont"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "allocation": {
      "type": "object",
      "required": [
        "must",
        "should",
        "could"
      ],
      "properties": {
        "must": {
          "type": "number",
          "minimum": 0
        },
        "should": {
          "type": "number",
          "minimum": 0
        },
        "could": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "required": [
        "netHours",
        "bufferHours",
        "bufferPercent"
      ],
      "properties": {
        "netHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bufferHours": {
          "type": "number",
          "minimum": 0
        },
        "bufferPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "cuts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "featureId",
          "rationale"
        ],
        "properties": {
          "featureId": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "freeze": {
      "type": "object",
      "required": [
        "milestone",
        "milestoneDate",
        "freezeDate"
      ],
      "properties": {
        "milestone": {
          "type": "string",
          "minLength": 3
        },
        "milestoneDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "freezeDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "const": "EXECUTE"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "unavailableChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
