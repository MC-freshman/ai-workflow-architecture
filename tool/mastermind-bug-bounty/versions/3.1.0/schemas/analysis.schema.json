{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastermind Bug Bounty Workflow · ANALYSIS · 候选问题分析（委派 api-validation / crypto-analysis）",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary"
  ],
  "properties": {
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "unavailableChecks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delegations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
