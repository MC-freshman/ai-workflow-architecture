{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "expert-task output",
  "type": "object",
  "required": [
    "status",
    "stages"
  ],
  "properties": {
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conclusion": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
