{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-postmortem input",
  "type": "object",
  "required": [
    "scope",
    "subject",
    "sources"
  ],
  "properties": {
    "scope": {
      "enum": [
        "sprint",
        "milestone",
        "project"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 2
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
