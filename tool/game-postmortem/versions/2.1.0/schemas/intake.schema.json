{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "postmortem intake",
  "type": "object",
  "required": [
    "scope",
    "subject",
    "periods",
    "sources",
    "missing"
  ],
  "properties": {
    "scope": {
      "enum": [
        "sprint",
        "milestone",
        "project"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 2
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
