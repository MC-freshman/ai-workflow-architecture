{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-code-review output",
  "type": "object",
  "required": [
    "scope",
    "findings",
    "unavailableChecks"
  ],
  "properties": {
    "scope": {
      "const": "static-local-review"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "line",
          "severity",
          "reason"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 3
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 8
          }
        },
        "additionalProperties": false
      }
    },
    "unavailableChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
