{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-launch · EXECUTE",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary",
    "unavailableChecks",
    "phases",
    "blockers",
    "risks",
    "rollback",
    "decision",
    "decisionRationale"
  ],
  "properties": {
    "phases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "status": {
            "enum": [
              "complete",
              "in-progress",
              "blocked"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "severity",
          "owner",
          "mitigation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "owner": {
            "type": "string"
          },
          "mitigation": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "probability",
          "impact",
          "mitigation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "probability": {
            "enum": [
              "L",
              "M",
              "H"
            ]
          },
          "impact": {
            "enum": [
              "L",
              "M",
              "H"
            ]
          },
          "mitigation": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    },
    "rollback": {
      "type": "object",
      "required": [
        "trigger",
        "steps",
        "owner",
        "testedOn"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 10
        },
        "steps": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "testedOn": {
          "type": "string",
          "minLength": 4
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "enum": [
        "GO",
        "CONDITIONAL GO",
        "NO-GO"
      ]
    },
    "decisionRationale": {
      "type": "string",
      "minLength": 20
    },
    "stage": {
      "const": "EXECUTE"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "unavailableChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
