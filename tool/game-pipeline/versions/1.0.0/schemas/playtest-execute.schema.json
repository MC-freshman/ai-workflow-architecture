{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-playtest · EXECUTE",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary",
    "unavailableChecks",
    "objectives",
    "testers",
    "observations",
    "findings",
    "protocol"
  ],
  "properties": {
    "objectives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "observable",
          "metric",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 10
          },
          "observable": {
            "type": "boolean"
          },
          "metric": {
            "type": "string",
            "minLength": 3
          },
          "decision": {
            "type": "string",
            "minLength": 8
          },
          "unanswered": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "testers": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "profile",
          "fromDevelopmentTeam"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 3
          },
          "fromDevelopmentTeam": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "testerId",
          "behaviour"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "testerId": {
            "type": "string",
            "minLength": 1
          },
          "behaviour": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "objectiveId",
          "observationIds",
          "interpretation",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "objectiveId": {
            "type": "string",
            "minLength": 1
          },
          "observationIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "interpretation": {
            "type": "string",
            "minLength": 10
          },
          "action": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "facilitatorPlays",
        "sessionMinutes"
      ],
      "properties": {
        "facilitatorPlays": {
          "type": "boolean"
        },
        "sessionMinutes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "const": "EXECUTE"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "unavailableChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
