{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-ci-pipeline · EXECUTE",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary",
    "unavailableChecks",
    "engine",
    "buildTargets",
    "stages",
    "secrets",
    "deployment"
  ],
  "properties": {
    "engine": {
      "enum": [
        "godot",
        "unity",
        "unreal"
      ]
    },
    "buildTargets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "platform",
          "preset",
          "artifact",
          "stages"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "minLength": 2
          },
          "preset": {
            "type": "string",
            "minLength": 2
          },
          "artifact": {
            "type": "string",
            "minLength": 3
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "dependsOn",
          "runner",
          "timeoutMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "build",
              "test",
              "deploy"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "runner": {
            "type": "string",
            "minLength": 2
          },
          "timeoutMinutes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source",
          "usedBy"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "source": {
            "type": "string",
            "minLength": 2
          },
          "usedBy": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "deployment": {
      "type": "object",
      "required": [
        "channels"
      ],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "sdk",
              "requiresApproval"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2
              },
              "sdk": {
                "type": "string",
                "minLength": 2
              },
              "requiresApproval": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "const": "EXECUTE"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "unavailableChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
