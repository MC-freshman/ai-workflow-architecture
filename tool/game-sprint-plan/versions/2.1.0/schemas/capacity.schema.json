{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["members", "bufferPercent", "effectiveCapacityHours"],
  "properties": {
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "discipline", "availableDays", "productiveHoursPerDay"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "discipline": { "enum": ["code", "art", "audio", "design", "qa", "business"] },
          "availableDays": { "type": "integer", "minimum": 0 },
          "productiveHoursPerDay": { "type": "number", "exclusiveMinimum": 0, "maximum": 24 }
        }
      }
    },
    "bufferPercent": { "type": "number", "minimum": 0, "maximum": 50 },
    "effectiveCapacityHours": { "type": "number", "minimum": 0 },
    "tierBudgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "must": { "type": "number", "minimum": 0 },
        "should": { "type": "number", "minimum": 0 },
        "could": { "type": "number", "minimum": 0 }
      }
    },
    "velocity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sprintsObserved": { "type": "integer", "minimum": 0 },
        "averageCompletionRate": { "type": "number", "minimum": 0, "maximum": 1.5 },
        "source": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
