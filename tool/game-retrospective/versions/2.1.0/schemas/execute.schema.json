{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-retrospective · EXECUTE",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary",
    "unavailableChecks",
    "lenses",
    "killList",
    "oneThing",
    "actions"
  ],
  "properties": {
    "lenses": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "lens",
          "whatWorked",
          "whatDidNot",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "lens": {
            "type": "string",
            "minLength": 3
          },
          "whatWorked": {
            "type": "string"
          },
          "whatDidNot": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "killList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item",
          "reason",
          "decidedBy"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 5
          },
          "reason": {
            "type": "string",
            "minLength": 10
          },
          "decidedBy": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "oneThing": {
      "type": "object",
      "required": [
        "statement",
        "owner",
        "byWhen"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 20
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "byWhen": {
          "type": "string",
          "minLength": 4
        }
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "action",
          "owner",
          "due",
          "lensId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 10
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "due": {
            "type": "string",
            "minLength": 4
          },
          "lensId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "stage": {
      "const": "EXECUTE"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "unavailableChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
