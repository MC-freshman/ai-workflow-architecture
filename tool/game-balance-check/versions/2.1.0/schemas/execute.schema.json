{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-balance-check · EXECUTE",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary",
    "unavailableChecks",
    "metrics",
    "economy",
    "imbalances",
    "recommendations"
  ],
  "properties": {
    "metrics": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "observed",
          "target",
          "tolerance",
          "verdict"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "observed": {
            "type": "number"
          },
          "target": {
            "type": "number"
          },
          "tolerance": {
            "type": "number",
            "minimum": 0
          },
          "verdict": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "economy": {
      "type": "object",
      "required": [
        "currency",
        "faucets",
        "sinks",
        "netFlow"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 2
        },
        "faucets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "rate"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2
              },
              "rate": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "sinks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "rate"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2
              },
              "rate": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "netFlow": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "imbalances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "system",
          "issue",
          "severity",
          "impact",
          "recommendation",
          "expectedEffect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "system": {
            "type": "string",
            "minLength": 2
          },
          "issue": {
            "type": "string",
            "minLength": 10
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "impact": {
            "type": "string",
            "minLength": 5
          },
          "recommendation": {
            "type": "string",
            "minLength": 10
          },
          "expectedEffect": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "action",
          "expectedImpact",
          "addresses"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 10
          },
          "expectedImpact": {
            "type": "string",
            "minLength": 5
          },
          "addresses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "stage": {
      "const": "EXECUTE"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "unavailableChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
