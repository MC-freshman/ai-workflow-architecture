{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-launch input",
  "type": "object",
  "required": [
    "objective"
  ],
  "properties": {
    "gameTitle": {
      "type": "string",
      "minLength": 3
    },
    "launchDate": {
      "type": "string",
      "minLength": 3
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objective": {
      "type": "string",
      "minLength": 20
    }
  },
  "additionalProperties": false
}
