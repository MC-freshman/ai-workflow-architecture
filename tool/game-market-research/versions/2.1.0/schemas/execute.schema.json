{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-market-research · EXECUTE",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary",
    "unavailableChecks",
    "competitors",
    "market",
    "audience",
    "positioning",
    "recommendation"
  ],
  "properties": {
    "competitors": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "priceUsd",
          "strengths",
          "weaknesses",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "type": {
            "enum": [
              "direct",
              "indirect",
              "aspirational"
            ]
          },
          "priceUsd": {
            "type": "number",
            "minimum": 0
          },
          "strengths": {
            "type": "string",
            "minLength": 10
          },
          "weaknesses": {
            "type": "string",
            "minLength": 10
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "market": {
      "type": "object",
      "required": [
        "tamUsd",
        "samUsd",
        "somUsd",
        "method",
        "sources"
      ],
      "properties": {
        "tamUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "samUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "somUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "method": {
          "type": "string",
          "minLength": 10
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 5
          }
        }
      },
      "additionalProperties": false
    },
    "audience": {
      "type": "object",
      "required": [
        "segments"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "name",
              "sizePct",
              "needs"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 3
              },
              "sizePct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "needs": {
                "type": "string",
                "minLength": 10
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "positioning": {
      "type": "object",
      "required": [
        "statement",
        "differentiators"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 20
        },
        "differentiators": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 5
          }
        }
      },
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "required": [
        "verdict",
        "rationale"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "proceed",
            "revise",
            "abandon"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "const": "EXECUTE"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "unavailableChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
