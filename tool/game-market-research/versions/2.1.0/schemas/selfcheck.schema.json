{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-market-research · SELFCHECK",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary",
    "checks",
    "gateResult",
    "unavailableChecks"
  ],
  "properties": {
    "stage": {
      "const": "SELFCHECK"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "check",
          "result",
          "note"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 3
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not-run"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 3
          }
        },
        "additionalProperties": false
      }
    },
    "gateResult": {
      "type": "object",
      "required": [
        "gateId",
        "status",
        "reason",
        "artifact"
      ],
      "properties": {
        "gateId": {
          "const": "market-integrity"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 3
        }
      },
      "additionalProperties": false
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "unavailableChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
