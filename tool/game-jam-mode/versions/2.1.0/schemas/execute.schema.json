{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-jam-mode · EXECUTE",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary",
    "unavailableChecks",
    "jam",
    "tasks",
    "budget"
  ],
  "properties": {
    "jam": {
      "type": "object",
      "required": [
        "durationHours",
        "theme",
        "deadline"
      ],
      "properties": {
        "durationHours": {
          "type": "integer",
          "minimum": 1
        },
        "theme": {
          "type": "string",
          "minLength": 2
        },
        "deadline": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "tier",
          "estimateHours",
          "owner",
          "dependsOn"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "tier": {
            "enum": [
              "mvp",
              "polish",
              "submission"
            ]
          },
          "estimateHours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "mvpHours",
        "polishHours",
        "submissionHours"
      ],
      "properties": {
        "mvpHours": {
          "type": "number",
          "minimum": 0
        },
        "polishHours": {
          "type": "number",
          "minimum": 0
        },
        "submissionHours": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "const": "EXECUTE"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "unavailableChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
