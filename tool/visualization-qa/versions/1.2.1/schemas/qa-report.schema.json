{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "verdict",
    "previewSha256",
    "measuredBoxes"
  ],
  "properties": {
    "verdict": {
      "const": "PASS"
    },
    "previewSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "measuredBoxes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "element",
          "box"
        ],
        "additionalProperties": false,
        "properties": {
          "element": {
            "type": "string",
            "minLength": 1
          },
          "box": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "clipping": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "overlap": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "artifactsRuntimeRooted": {
      "type": "boolean"
    },
    "rendererVersion": {
      "type": "string"
    },
    "issues": {
      "type": "array"
    },
    "evidence": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
