{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-analytics-setup · EXECUTE",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary",
    "unavailableChecks",
    "goals",
    "events",
    "kpis",
    "privacy"
  ],
  "properties": {
    "goals": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "kpis",
          "eventNames"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 10
          },
          "kpis": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "eventNames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "name",
          "trigger",
          "properties"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3
          },
          "trigger": {
            "type": "string",
            "minLength": 5
          },
          "properties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 2
                },
                "type": {
                  "enum": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "kpis": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "formula",
          "target",
          "reviewCadence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "formula": {
            "type": "string",
            "minLength": 8
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "reviewCadence": {
            "type": "string",
            "minLength": 2
          }
        },
        "additionalProperties": false
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "regimes",
        "consentRequired",
        "dataRetentionDays",
        "piiEvents"
      ],
      "properties": {
        "regimes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "consentRequired": {
          "type": "boolean"
        },
        "dataRetentionDays": {
          "type": "integer",
          "minimum": 0
        },
        "piiEvents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "const": "EXECUTE"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "unavailableChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
