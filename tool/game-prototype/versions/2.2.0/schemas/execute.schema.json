{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-prototype · EXECUTE",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary",
    "unavailableChecks",
    "prototypePlan",
    "metrics",
    "decisionRules"
  ],
  "properties": {
    "prototypePlan": {
      "type": "object",
      "required": [
        "hypothesis",
        "scope",
        "durationDays",
        "build",
        "cut"
      ],
      "properties": {
        "hypothesis": {
          "type": "string",
          "minLength": 20
        },
        "scope": {
          "type": "string",
          "minLength": 10
        },
        "durationDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "build": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "cut": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "target",
          "instrument",
          "method"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "instrument": {
            "type": "string",
            "minLength": 2
          },
          "method": {
            "type": "string",
            "minLength": 5
          }
        },
        "additionalProperties": false
      }
    },
    "decisionRules": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "metricId",
          "threshold",
          "verdict",
          "action"
        ],
        "properties": {
          "metricId": {
            "type": "string",
            "minLength": 1
          },
          "threshold": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "keep",
              "iterate",
              "cut"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    },
    "stage": {
      "const": "EXECUTE"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "unavailableChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
