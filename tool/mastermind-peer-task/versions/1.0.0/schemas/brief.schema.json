{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastermind Peer Task · BRIEF · 接收 brief、范围与禁止项",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary"
  ],
  "properties": {
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "unavailableChecks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "peerId": {
      "type": "string"
    },
    "brief": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
