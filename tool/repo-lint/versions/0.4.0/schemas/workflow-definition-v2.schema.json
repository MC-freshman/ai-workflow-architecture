{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai:workflow-definition:v2",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "mode",
    "maxParallel",
    "stages"
  ],
  "properties": {
    "schema": {
      "const": "ai-workflow-definition/v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "mode": {
      "enum": [
        "prompt-skill",
        "pipeline",
        "executable-with-evidence",
        "agent-orchestration"
      ]
    },
    "maxParallel": {
      "const": 1
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requires": {
      "type": "object"
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "outputWorker": {
      "type": "string",
      "minLength": 1
    },
    "gateDefinitions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "action",
          "worker"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "action": {
            "enum": [
              "script",
              "prompt",
              "peer-agent",
              "subworkflow",
              "software-call"
            ]
          },
          "worker": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "script": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "promptRef": {
            "type": "string",
            "pattern": "^.+#stage:[A-Za-z0-9_-]+$"
          },
          "software": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "capability": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "externalBoundary": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "uniqueItems": true
              },
              "pathRoots": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "inputs": {
            "type": "string",
            "minLength": 1
          },
          "outputs": {
            "type": "string",
            "minLength": 1
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "onFail": {
            "enum": [
              "stop",
              "repair"
            ]
          },
          "maxIterations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "repairScript": {
            "type": "string",
            "minLength": 1
          },
          "repairPromptRef": {
            "type": "string",
            "minLength": 1
          },
          "peers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subworkflow": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "script"
                }
              }
            },
            "then": {
              "required": [
                "script"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "prompt"
                }
              }
            },
            "then": {
              "required": [
                "promptRef"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "software-call"
                }
              }
            },
            "then": {
              "required": [
                "software",
                "capability"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "script"
                    ]
                  },
                  {
                    "required": [
                      "promptRef"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "onFail": {
                  "const": "repair"
                }
              },
              "required": [
                "onFail"
              ]
            },
            "then": {
              "required": [
                "maxIterations"
              ],
              "anyOf": [
                {
                  "required": [
                    "repairScript"
                  ]
                },
                {
                  "required": [
                    "repairPromptRef"
                  ]
                }
              ]
            }
          }
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^x-": true
        }
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^x-": true
  }
}
