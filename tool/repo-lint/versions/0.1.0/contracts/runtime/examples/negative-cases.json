  {"id": "N28", "description": "Generated evidence must not enter initial inputs", "path": ["lock", "input", "files", 0, "path"], "value": "work/project/generated.py", "expect": "input:prefix"},
  {"id": "N29", "description": "Unpaired surrogate prohibited in canonical JSON", "path": ["lock", "input", "parameters", "bad"], "value": "\ud800", "expect": "canonical:"},
  {"id": "N30", "description": "Integer outside portable range", "path": ["lock", "input", "parameters", "seed"], "value": 9007199254740992, "expect": "canonical:"},
  {"id": "N31", "description": "Stale attempt submitted", "path": ["messages", 4, "payload", "attempt"], "value": 2, "expect": "submit:attempt"},
  {"id": "N32", "description": "Receipt references another transaction event", "path": ["transactions", 0, "eventSequences"], "value": [2], "expect": "transaction:event-link"},
  {"id": "N33", "description": "Invalid date-time rejected with format checking", "path": ["lock", "createdAt"], "value": "2026-99-99", "expect": "schema:"},
  {"id": "N34", "description": "Submitted output is outside immutable evidence", "path": ["states", 4, "completed", 0, "outputs", 0, "path"], "value": "work/project/result.txt", "expect": "evidence:prefix"},
  {"id": "N35", "description": "Status cannot take a mutation key", "path": ["messages", 6, "idempotencyKey"], "value": "poll-key", "expect": "schema:"},
  {"id": "N36", "description": "Prompt task cannot be newly issued after stop request", "path": ["messages", 3, "result", "state", "stopRequested"], "value": true, "expect": "next:stop-requested"},
  {"id": "N37", "description": "A succeeded event cannot describe running state", "path": ["events", 4, "status"], "value": "running", "expect": "event:type-status"},
  {"id": "N38", "description": "Claimed no-task reason contradicts terminal state", "path": ["messages", 11, "result", "reason"], "value": "waiting", "expect": "next:reason-state"}
