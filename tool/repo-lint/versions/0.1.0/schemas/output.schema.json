{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "version", "generatedAt", "roots", "summary", "decision", "coverage", "resources", "findings"],
  "properties": {
    "schema": {"const": "ai-repo-lint-report/v1"},
    "version": {"const": "0.1.0"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "roots": {"type": "object", "required": ["tool", "agent"], "properties": {"tool": {"type": "string"}, "agent": {"type": "string"}}},
    "selection": {"type": ["string", "null"]},
    "summary": {"type": "object", "required": ["errors", "warnings", "infos", "resourceCount", "checkedFiles", "exitCode"], "properties": {"errors": {"type": "integer", "minimum": 0}, "warnings": {"type": "integer", "minimum": 0}, "infos": {"type": "integer", "minimum": 0}, "resourceCount": {"type": "integer", "minimum": 0}, "checkedFiles": {"type": "integer", "minimum": 0}, "exitCode": {"enum": [0, 1, 2]}}},
    "decision": {"type": "object", "required": ["scope", "status", "runtimeStatus", "blockingFindings"], "properties": {"scope": {"enum": ["inventory", "selection"]}, "status": {"enum": ["blocked", "static-pass"]}, "runtimeStatus": {"const": "not-validated"}, "blockingFindings": {"type": "array"}}},
    "coverage": {"type": "object"},
    "resources": {"type": "array", "items": {"type": "object", "required": ["kind", "id", "version", "path", "manifestSchema"]}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["rule", "severity", "code", "kind", "id", "version", "path", "message"], "properties": {"rule": {"type": "string", "pattern": "^R(?:[1-9]|1[0-4])$"}, "severity": {"enum": ["error", "warning", "info"]}, "code": {"type": "string"}, "message": {"type": "string"}}}}
  },
  "additionalProperties": false
}
