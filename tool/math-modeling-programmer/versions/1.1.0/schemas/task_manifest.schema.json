{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["manifest_id", "entrypoint", "tasks"],
  "properties": {
    "manifest_id": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string", "minLength": 1},
    "base_args": {"type": "array", "items": {"type": ["string", "number", "boolean"]}},
    "shared_inputs": {"type": "array", "items": {"type": "string"}},
    "output_root": {"type": "string", "minLength": 1},
    "continue_on_error": {"type": "boolean"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "kind", "title", "args", "outputs"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "parent_question": {"type": "string"},
          "kind": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "objective": {"type": "string"},
          "args": {"type": "array", "items": {"type": ["string", "number", "boolean"]}},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "acceptance": {"type": "array", "items": {"type": "string"}},
          "priority": {"type": "string"},
          "claim": {"type": "string"},
          "paper_candidate": {"type": "boolean"},
          "seed": {"type": ["integer", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
