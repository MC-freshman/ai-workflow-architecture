{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["entrypoint", "runs"],
  "properties": {
    "entrypoint": {"type": "string", "minLength": 1},
    "base_args": {"type": "array", "items": {"type": "string"}},
    "runs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "args": {"type": "array"}, "seed": {}}}}
  },
  "additionalProperties": true
}
