{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-brainstorm · EXECUTE",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary",
    "unavailableChecks",
    "concepts",
    "ranking",
    "openQuestions"
  ],
  "properties": {
    "concepts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "oneLiner",
          "coreLoop",
          "hook",
          "audience"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "oneLiner": {
            "type": "string",
            "minLength": 10
          },
          "coreLoop": {
            "type": "string",
            "minLength": 10
          },
          "hook": {
            "type": "string",
            "minLength": 5
          },
          "audience": {
            "type": "string",
            "minLength": 3
          }
        },
        "additionalProperties": false
      }
    },
    "ranking": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "conceptId",
          "score",
          "rationale"
        ],
        "properties": {
          "conceptId": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    },
    "openQuestions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "question",
          "impact"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 10
          },
          "impact": {
            "enum": [
              "L",
              "M",
              "H"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "stage": {
      "const": "EXECUTE"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "unavailableChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
