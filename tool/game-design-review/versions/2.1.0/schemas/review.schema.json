{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "design-review findings",
  "type": "object",
  "required": [
    "findings",
    "summary"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "section",
          "evidence",
          "recommendation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z]+-[0-9]+$"
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "section": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "minLength": 8
          },
          "recommendation": {
            "type": "string",
            "minLength": 8
          },
          "principle": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "critical",
        "major",
        "minor"
      ],
      "additionalProperties": false,
      "properties": {
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
